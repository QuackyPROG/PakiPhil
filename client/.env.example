# Server only. Copy to .env.local; never prefix these with NEXT_PUBLIC_.
LUMEN_API_KEY=
LUMEN_API_SECRET=
# Optional: defaults to the staging gateway published by the sandbox docs.
LUMEN_BASE_URL=
# Optional: discovers Pirma Lang Extractor or the active hackathon blank instance.
LUMEN_AI_INSTANCE_ID=
GEMINI_API_KEY=
# Optional: defaults to gemini-2.5-flash; choose a model enabled for your key.
GEMINI_MODEL=
